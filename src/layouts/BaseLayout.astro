---
import { withBase } from '../lib/urls';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'GOAT-recepten',
  description = 'Een compacte verzameling van onze favoriete familierecepten.',
} = Astro.props;
const pageTitle = title === 'GOAT-recepten' ? title : `${title} · GOAT-recepten`;
const homeUrl = withBase('', import.meta.env.BASE_URL);
const faviconUrl = withBase('favicon.svg', import.meta.env.BASE_URL);
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f4ed" />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#inhoud">Ga naar de inhoud</a>
    <header class="site-header">
      <div class="page-shell header-inner">
        <a class="wordmark" href={homeUrl} aria-label="GOAT-recepten, naar de startpagina">
          <span class="wordmark-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" focusable="false">
              <path d="M4 12h18v3c0 5-3.5 8-9 8s-9-3-9-8v-3Zm18 2h7" />
            </svg>
          </span>
          <strong>GOAT-recepten</strong>
        </a>
      </div>
    </header>
    <main id="inhoud" class="page-shell">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="page-shell">Met zorg verzameld voor familie en vrienden.</div>
    </footer>
  </body>
</html>
