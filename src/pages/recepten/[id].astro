---
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import RecipeImage from '../../components/RecipeImage.astro';
import ServingScaler from '../../components/ServingScaler.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/urls';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((recipe) => ({ params: { id: recipe.id }, props: { recipe } }));
}

const { recipe } = Astro.props;
const { data } = recipe;
const homeUrl = withBase('', import.meta.env.BASE_URL);
---

<BaseLayout title={data.title} description={data.description}>
  <nav class="breadcrumbs" aria-label="Kruimelpad">
    <a href={homeUrl}>Recepten</a><span aria-hidden="true">/</span><span aria-current="page">{data.title}</span>
  </nav>
  <article class="recipe-detail">
    <header class="recipe-intro">
      <div>
        <p class="eyebrow">{data.mealType}</p>
        <h1>{data.title}</h1>
        <p class="recipe-lead">{data.description}</p>
        <dl class="recipe-facts">
          <div><dt>Totale kooktijd</dt><dd>{data.totalTime} min</dd></div>
        </dl>
        {data.kenmerken.length > 0 && (
          <div class="tag-list" aria-label="Kenmerken">
            {data.kenmerken.map((label: string) => <span>{label}</span>)}
          </div>
        )}
      </div>
      <RecipeImage image={data.image as ImageMetadata | undefined} alt={data.imageAlt} priority />
    </header>

    <div class="recipe-columns">
      <ServingScaler ingredients={data.ingredients} />
      <section class="method" aria-labelledby="method-heading">
        <p class="eyebrow">Stap voor stap</p>
        <h2 id="method-heading">Bereiding</h2>
        <ol>
          {data.steps.map((step: string) => <li><span>{step}</span></li>)}
        </ol>
        {data.notes && (
          <aside class="recipe-note" aria-labelledby="note-heading">
            <h3 id="note-heading">Goed om te weten</h3>
            <p>{data.notes}</p>
          </aside>
        )}
      </section>
    </div>
  </article>
</BaseLayout>
