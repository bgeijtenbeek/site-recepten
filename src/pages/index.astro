---
import { getCollection } from 'astro:content';
import RecipeDiscovery from '../components/RecipeDiscovery.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { KENMERKEN, MEAL_TYPES } from '../data/taxonomies';
import { toRecipeSummary } from '../lib/recipes';
import { sortRecipesByTitle } from '../lib/sort';
import { kenmerkUrl, mealTypeUrl } from '../lib/urls';

const entries = await getCollection('recipes');
const recipes = sortRecipesByTitle(entries.map(toRecipeSummary));
---

<BaseLayout>
  <RecipeDiscovery recipes={recipes}>
    <div slot="categories" class="homepage-taxonomies">
      <nav class="category-section" aria-label="Maaltijdtypes">
        <details class="category-disclosure">
          <summary>
            <span class="category-summary-copy">
              <span class="eyebrow">Blader op moment</span>
              <span class="category-title">Maaltijdtypes</span>
            </span>
            <span class="disclosure-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="m7 10 5 5 5-5" /></svg>
            </span>
          </summary>
          <ul class="category-links category-links--homepage">
            {MEAL_TYPES.map(({ label, slug }) => (
              <li><a href={mealTypeUrl(slug, import.meta.env.BASE_URL)}><span>{label}</span><span aria-hidden="true">→</span></a></li>
            ))}
          </ul>
        </details>
      </nav>
      <nav class="category-section" aria-label="Blader op kenmerken">
        <details class="category-disclosure">
          <summary>
            <span class="category-summary-copy">
              <span class="eyebrow">Blader op ingrediënt of soort</span>
              <span class="category-title">Kenmerken</span>
            </span>
            <span class="disclosure-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="m7 10 5 5 5-5" /></svg>
            </span>
          </summary>
          <ul class="category-links category-links--homepage">
            {KENMERKEN.map(({ label, slug }) => (
              <li><a href={kenmerkUrl(slug, import.meta.env.BASE_URL)}><span>{label}</span><span aria-hidden="true">→</span></a></li>
            ))}
          </ul>
        </details>
      </nav>
    </div>
  </RecipeDiscovery>
</BaseLayout>
